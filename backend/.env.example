# ── Application Configuration ───────────────────────────────────────────
APP_NAME=Clip Cutter
DEBUG=True
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./clipcutter.db

# ── JWT Authentication Secret ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=clip-cutter-production-jwt-secret-replace-me-with-random-hex
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Default Administrator Account ───────────────────────────────────────
ADMIN_EMAIL=test@test.com
ADMIN_PASSWORD=test@123

# ── Google OAuth 2.0 (Google Identity Services) ─────────────────────────
# Obtain from https://console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SMS Gateway Configuration (Phone OTP Verification) ──────────────────
# Choose provider: fast2sms | twilio | msg91 | console
SMS_PROVIDER=fast2sms

# 1. Fast2SMS (Recommended for India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 2. Twilio (Global SMS - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 3. MSG91 (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_otp_template_id_here

# ── Phone OTP Policies ──────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_RATE_LIMIT_MAX_REQUESTS=3

# ── Billing (Razorpay Gateway) ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Acceleration & FFmpeg ───────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
FFMPEG_NVENC=True
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Ollama Local LLM ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
