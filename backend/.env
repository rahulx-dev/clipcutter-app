MSG91_TEMPLATE_ID=

# OTP Policy
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_RATE_LIMIT_MAX_REQUESTS=3

# Pricing & Plans
FREE_CREDITS=3
BASE_PLAN_CREDITS=50
PRO_PLAN_CREDITS=150
BASE_PLAN_PRICE_INR=99
PRO_PLAN_PRICE_INR=199

# Razorpay
